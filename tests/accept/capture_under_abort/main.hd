// spec: §58
// expect: [7]
effect Y
capture y(value: Int): Unit
effect E
abort e(reason: Int)
handler Y as Collect
capture y value => let rest = resume () -> [value, ...rest]
return _ => []
handler E as Trap
abort e reason => [reason]
return _ => []
def main = with Collect -> with Trap -> do y 7 -> ()
