// spec: §38
// expect: [5]
effect Z
again z(value: Int): Void
effect Y
again y(value: Int): Void
effect B
once b: Int
handler Z as Outer
again z value => resume () as rest ->
  [value, ...rest]
return _ => []
handler Y as Collect
again y value => resume () as rest ->
  [value, ...rest]
return _ => []
handler B as Inner
once b => 2
def main = with Outer -> with Collect -> with Inner -> y b ->
  z 5 ->
  ()
