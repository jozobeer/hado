// spec: §34
// expect: 42
// item: let p? =
// needs: prelude
type Box = | Box(Int)
type Entry = { value: Box }
def pass (n: Int): Void {Error} => if n > 0 => () | raise { message = "negative" }
def read (entry: Entry Option): Int {Error} => if entry | Some({ value = Box(n) }) => pass n ->
  pass (n + 1) ->
  n + 2 | None => raise { message = "missing" }
  /if
def main = Int.to_string (read Some({ value = Box(40) }))
