// spec: §22
// expect: 42
// item: let p? =
type Box = | Box(Int)
type Entry = { value: Box }
def pass (n: Int): (Unit, String) Result => if n > 0 => Ok() | Error("negative")
def read (entry: (Entry, String) Result): (Int, String) Result =>
  let { value = Box(n) }? = entry ->
  do pass n ->
  do pass (n + 1) ->
  let Box(m)? = Ok(Box(n + 2)) ->
  Ok(m)
def main = read (Ok({ value = Box(40) }))
