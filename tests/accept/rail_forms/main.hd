// spec: §34
// expect: 42
// item: let p? =
// needs: prelude
type Box = | Box(Int)
type Entry = { value: Box }
def pass (n: Int): Void {Error} => if n > 0 => () | raise { message = "negative" }
def read (entry: Entry Option): Int {Error} => Option.ok_or (entry as { value = Box(n) }? ->
  pass n ->
  pass (n + 1) ->
  Some(Box(n + 2)) as Box(m)? ->
  Some(m)) { message = "missing" }
def main = Int.to_string (read Some({ value = Box(40) }))
