// spec: §38
// expect: [3, 102]
effect Z
again z(value: Int): Void
effect W
again w(value: Int): Void
handler Z as Outer
again z value => resume () as rest ->
  [value, ...rest]
return x => x
handler W as Inner
again w value => [value + 100, ...resume ()]
return _ => []
def main = with Outer -> with Inner -> w 2 ->
  z 3 ->
  ()
