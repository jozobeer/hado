// spec: §38
// expect: [3, 102]
effect Z
again z(value: Int): Unit
effect W
again w(value: Int): Unit
handler Z as Outer
again z value => let rest = resume () -> [value, ...rest]
return x => x
handler W as Inner
again w value => [value + 100, ...resume ()]
return _ => []
def main = with Outer -> with Inner -> do w 2 -> do z 3 -> ()
