-- spec: §39
-- expect: ok
-- item: 関数適用
def parse (input: List<Int>): Result<List<Int>, String> => Ok(input)
def validate | Nil => Ok() | Cons(_, _) => Error("invalid")
def authorize | Nil => Ok() | Cons(_, _) => Error("denied")
def save | Nil => Ok("ok") | Cons(_, _) => Error("save failed")
def create_user input =>
  let? parsed = parse input ->
  do? validate parsed ->
  do? authorize parsed ->
  let? saved = save parsed ->
  Ok(saved)
def main = create_user Nil
