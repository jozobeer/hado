// spec: §58
// expect:
// item: 呼び出し構文
def find_user (id: Int): Int {Error} => id
def authorize_delete user => if user == 1 => () | raise { message = "denied" }
def delete user => if user == 1 => () | raise { message = "delete failed" }
def delete_user id =>
  let user = find_user id ->
  do authorize_delete user ->
  delete user
def main = delete_user 1
