// spec: 付録B
// expect:
// item: 呼び出し構文
def find_user (id: Int): Int {Error} => id
def authorize_delete user => if user == 1 => () | { message = "denied" } |> raise
def delete user => if user == 1 => () | { message = "delete failed" } |> raise
def delete_user id =>
  let user = id |> find_user ->
  do user |> authorize_delete ->
  user |> delete
def main = 1 |> delete_user
