// spec: §39
// expect:
// item: 呼び出し構文
def find_user (id: Int): (Int, String) Result => Ok(id)
def authorize_delete user => if user == 1 => Ok() | Error("denied")
def delete user => if user == 1 => Ok() | Error("delete failed")
def delete_user id =>
  let user? = find_user id ->
  do authorize_delete user ->
  do delete user ->
  Ok()
def main = delete_user 1
