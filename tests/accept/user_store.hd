-- spec: §39
-- expect: 1
-- item: module
type Error = | NotFound
module type USER_STORE = sig
  type T

  def find(id: Int): Option<T>
  def save(user: T): Result<Unit, Error>
  def delete(user: T): Result<Unit, Error>
end
module UserStore : USER_STORE = struct
  type T = Error
  def find id => if id > 0 => Some(NotFound) | None
  def save user => Error(user)
  def delete user => Error(user)
end
def main = if UserStore.find 1 | Some(_) => 1 | 0
