// spec: §55
// expect: [1, 2, 3]
// needs: prelude
effect A Yield
again yield(value: A): Void
handler A Yield as Collect
again yield value =>
  let rest = resume () ->
  [value, ...rest]
return _ => []
def mark (x: Int): Int {Int Yield} => do yield x -> x
def main = with Collect -> List.map [1, 2, 3] mark
