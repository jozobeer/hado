// spec: 付録B
// expect: ok
// item: 関数適用
def parse (input: Int List): Int List {Error} => input
def validate | [] => () | [_, ..._] => raise { message = "invalid" }
def authorize | [] => () | [_, ..._] => raise { message = "denied" }
def save | [] => "ok" | [_, ..._] => raise { message = "save failed" }
def create_user input => parse input as parsed ->
  validate parsed ->
  authorize parsed ->
  save parsed
def main = create_user []
