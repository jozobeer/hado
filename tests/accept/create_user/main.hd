// spec: 付録B
// expect: ok
// item: 関数適用
def parse (input: Int List): Int List {Error} => input
def validate | [] => () | [_, ..._] => { message = "invalid" } |> raise
def authorize | [] => () | [_, ..._] => { message = "denied" } |> raise
def save | [] => "ok" | [_, ..._] => { message = "save failed" } |> raise
def create_user input =>
  let parsed = input |> parse ->
  do parsed |> validate ->
  do parsed |> authorize ->
  parsed |> save
def main = [] |> create_user
