// spec: §38
// expect: [1, 102]
effect Y
again y(value: Int): Void
effect W
again w(value: Int): Void
handler Y as Collect
again y value => let rest = resume () -> [value, ...rest]
return x => x
handler W as Inner
again w value => let rest = resume () -> [value + 100, ...rest]
return _ => []
def main = with Collect -> with Inner -> do y 1 -> do w 2 -> ()
