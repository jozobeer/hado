// spec: §38
// expect: [1, 102]
effect Y
again y(value: Int): Void
effect W
again w(value: Int): Void
handler Y as Collect
again y value => resume () as rest ->
  [value, ...rest]
return x => x
handler W as Inner
again w value => resume () as rest ->
  [value + 100, ...rest]
return _ => []
def main = with Collect -> with Inner -> y 1 ->
  w 2 ->
  ()
