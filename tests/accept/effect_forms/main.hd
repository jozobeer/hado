// spec: §38
// expect: 1
// item: 効果の宣言
effect Ask
reply ask: String
effect Stop
abort stop
effect A Yield
capture yield(value: A): Unit
handler Ask as HAsk
reply ask => ""
handler Stop as HStop
abort stop => 0
handler A Yield as HYield
capture yield _ => resume ()
def id (x: Int): Int {Ask, Stop, Int Yield} => x
def main =
  with HAsk ->
  with HStop ->
  with HYield ->
  id 1
