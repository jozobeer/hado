// spec: §37
// expect: 1
// item: 効果の宣言
effect Ask
once ask: String
effect Stop
abort stop
effect A Yield
again yield(value: A): Void
handler Ask as HAsk
once ask => ""
handler Stop as HStop
abort stop => 0
handler A Yield as HYield
again yield _ => resume ()
def id (x: Int): Int {Ask, Stop, Int Yield} => x
def main = with HAsk -> with HStop -> with HYield -> id 1
