// spec: §39
// expect: [3, 102]
effect Z
capture z(value: Int): Unit
effect W
capture w(value: Int): Unit
handler Z as Outer
capture z value => let rest = resume () -> [value, ...rest]
return x => x
handler W as Inner
capture w value => [value + 100, ...resume ()]
return _ => []
def main = with Outer -> with Inner -> do w 2 -> do z 3 -> ()
