// spec: §48
// item: 末尾呼び出しの限定
// needs: prelude
// expect: 10000
effect A Yield
capture yield(value: A): Unit
handler A Yield as Collect
capture yield value =>
  let rest = resume () ->
  [value, ...rest]
return _ => []
def rec loop (n: Int): Unit {Int Yield} =>
  if n <= 0 => ()
  | do yield n -> loop (n - 1)
def main = List.length (with Collect -> loop 10000)
