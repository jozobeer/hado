// spec: §26
// expect: [1, 2, 3, 4, 5, 6]
def rec merge left right comparator => if left, right | [], _ => right | _, [] => left | [a, ...rest_a], [b, ...rest_b] => if  | comparator a b <= 0 => [a, ...merge rest_a right comparator] | [b, ...merge left rest_b comparator]
def main = merge [1, 3, 5] [2, 4, 6] fn(a, b => a - b)
