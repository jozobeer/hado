// spec: §48
// expect: ab
// item: 型の共有
// needs: prelude
def main = StringFold.fold ["a", "b"]
module Monoid
type T
def combine(left: T, right: T): T Pure
def of(value: String): T Pure
def empty: T Pure
def show(value: T): String Pure
module Fold
type T
def fold(values: T List): T Pure
implement Monoid as StringMonoid
shared type T = String
def combine left right => String.concat left right
def of value => value
def empty = ""
def show value => value
implement Fold as MakeFold(M: Monoid)
shared type T = M.T
def fold values => List.fold values M.empty M.combine
implement Fold as StringFold = MakeFold(StringMonoid)
