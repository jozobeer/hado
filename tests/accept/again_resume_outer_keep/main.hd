// spec: §38
// expect: [2, 1]
effect Z
again z(value: Int): Void
effect Y
again y(value: Int): Void
handler Z as Outer
again z value => let rest = resume () -> [value, ...rest]
return x => x
handler Y as Collect
again y value => let rest = resume () -> [value, ...rest]
return _ => []
def main = with Outer -> with Collect -> do y 1 -> do z 2 -> ()
