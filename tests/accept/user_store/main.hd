type User = { id: Int }
def saved
| Some(user) => do UserStore.save user -> true
| false
def main =
  let ok = 1 |> UserStore.find |> saved ->
  if ok => 1 | 0
module UserStore
type T
def find(id: Int): T Option
def save(user: T): Unit {Error}
def delete(user: T): Unit {Error}
implement UserStore as UserStore
type T = User
def find id => if id > 0 => Some({ id = id }) | None
def save(_: T): Unit {Error} => ()
def delete user => if user.id > 0 => () | raise { message = "NotFound" }
