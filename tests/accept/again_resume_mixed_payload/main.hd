// spec: §38
// expect: ["b", "1"]
// needs: prelude
effect S
again s(value: String): Void
effect Y
again y(value: Int): Void
handler S as Names
again s value => let rest = resume () -> [value, ...rest]
return x => x
handler Y as Collect
again y value => let rest = resume () -> [String.concat "" (Int.to_string value), ...rest]
return _ => []
def main = with Names -> with Collect -> do y 1 -> do s "b" -> ()
