// spec: §38
// expect: ["b", "1"]
// needs: prelude
effect S
again s(value: String): Void
effect Y
again y(value: Int): Void
handler S as Names
again s value => resume () as rest ->
  [value, ...rest]
return x => x
handler Y as Collect
again y value => resume () as rest ->
  [String.concat "" (Int.to_string value), ...rest]
return _ => []
def main = with Names -> with Collect -> y 1 ->
  s "b" ->
  ()
