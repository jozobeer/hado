// spec: §38
// expect: [2]
effect Z
again z(value: Int): Void
effect Y
again y(value: Int): Void
handler Z as Outer
again z value => resume () as rest ->
  [value, ...rest]
return _ => []
handler Y as Collect
again y value => resume () as rest ->
  [value, ...rest]
return _ => []
def main = with Outer -> with Collect -> y 1 ->
  z 2 ->
  ()
