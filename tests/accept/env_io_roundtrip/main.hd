// spec: §55
// item: Env と Io
// expect: { argv = []; stdin = 0; same = true }
// needs: prelude
type Observation = { argv: String List; stdin: Int; same: Bool }
def main = Bytes.of_string "roundtrip" as source ->
  write_file "fixture" source ->
  { argv = args; stdin = Bytes.length read_stdin; same = read_file "fixture" == source }
