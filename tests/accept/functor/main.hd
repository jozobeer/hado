// spec: 付録B
// expect: plain:7 / offset:107
// item: Functor
// needs: prelude
def main =
  "plain:"
  |> PlainStore.create 7
  |> PlainStore.describe
  |> String.concat (" / " |> String.concat ("offset:" |> OffsetStore.create 7 |> OffsetStore.describe))
implement Store as MakeStore(Id: UserId)
type T = Payload { id: Id.T; name: String }
def create name number => Payload { id = number |> Id.make; name = name }
def describe user => user.name |> String.concat (user.id |> Id.value |> Int.to_string)
