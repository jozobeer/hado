// spec: §37
// expect: 1
// item: 効果行
effect Ask
reply ask: String
effect Io
reply tick: Unit
handler Ask as HAsk
reply ask => ""
handler Io as HIo
reply tick => ()
def ordered (x: Int): Int {Io, Ask} => x
def omitted x => x
def claimed (x: Int): Int Pure => x
def main =
  with HAsk ->
  with HIo ->
  ordered (omitted (claimed 1))
