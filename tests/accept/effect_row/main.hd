// spec: §20
// expect: 1
// item: 効果行
// needs: prelude
effect Ask
once ask: String
effect Log
once tick: Void
handler Ask as HAsk
once ask => ""
handler Log as HLog
once tick => ()
def ordered (x: Int): Int {Log, Ask} => x
def omitted x => x
def claimed (x: Int): Int Pure => x
def main = Int.to_string (with HAsk -> with HLog -> ordered (omitted (claimed 1)))
