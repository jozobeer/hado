// spec: §37
// expect: 1
// item: 効果行
effect Ask
reply ask: String
effect Log
reply tick: Unit
handler Ask as HAsk
reply ask => ""
handler Log as HLog
reply tick => ()
def ordered (x: Int): Int {Log, Ask} => x
def omitted x => x
def claimed (x: Int): Int Pure => x
def main =
  with HAsk ->
  with HLog ->
  ordered (omitted (claimed 1))
