// spec: §16
// expect: 7
// item: 型の綴り
// needs: prelude
type A Packet = { payload: A }
type (A, B) Wrap = | Hold(A) | Tag(B)
def score (box: (Int List, String) Wrap Packet): Int => if box.payload | Hold(items) => List.length items | Tag(_) => 0
def main = Int.to_string (score { payload = Hold([1, 2]) } + Box.size (Box.make [3]) + Box.run fn(f, x => f x) 4)
module Box
type T
def make (xs: Int List): T
def size (xs: T): Int
def A run (f: Fn(Fn(A => A), A => A), x: A): A
/module
implement Box as Box
type T = Int List
def make xs => xs
def size xs => List.length xs
def run f x => f fn(value => value) x
/implement
