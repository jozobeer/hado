// spec: §58.4
def code_of line =>
  let after = line |> String.split "\"code\": \"" |> List.nth 1 |> Option.unwrap_or "" ->
  after |> String.split "\"" |> List.head |> Option.unwrap_or ""

def same_code line code => (line |> code_of) == code

def count_of lines code => lines |> List.filter fn(line => line |> same_code code) |> List.length

def rec summarize lines seen =>
  if lines
    | [] => ""
    | [line, ...rest] => line |> summarize_one lines rest seen

def rec summarize_one line lines rest seen =>
  let code = line |> code_of ->
  if code == "" => rest |> summarize seen | code |> emit lines rest seen

def rec emit code lines rest seen =>
  let known = seen |> List.filter fn(one => one == code) |> List.length ->
  if known == 0 => code |> line_for lines rest seen | rest |> summarize seen

def rec line_for code lines rest seen =>
  let body = code |> String.concat " " ->
  let body = body |> String.concat (lines |> count_of code |> Int.to_string) ->
  body |> String.concat ("\n" |> String.concat (rest |> summarize [code, ...seen]))

def main =
  let bytes = IoDefault.read_stdin ->
  bytes |> Bytes.to_string |> String.split "\n" |> summarize [] |> IoDefault.log
