// spec: §58.4
def code_of line =>
  let after = Option.unwrap_or (List.nth (String.split line "\"code\": \"") 1) "" ->
  Option.unwrap_or (List.head (String.split after "\"")) ""

def same_code line code => code_of line == code

def count_of lines code => List.length (List.filter lines fn(line => same_code line code))

def rec summarize lines seen =>
  if lines
    | [] => ""
    | [line, ...rest] => summarize_one line lines rest seen

def rec summarize_one line lines rest seen =>
  let code = code_of line ->
  if code == "" => summarize rest seen | emit code lines rest seen

def rec emit code lines rest seen =>
  let known = List.length (List.filter seen fn(one => one == code)) ->
  if known == 0 => line_for code lines rest seen | summarize rest seen

def rec line_for code lines rest seen =>
  let body = String.concat code " " ->
  let body = String.concat body (Int.to_string (count_of lines code)) ->
  String.concat body (String.concat "\n" (summarize rest [code, ...seen]))

def main =
  let bytes = IoDefault.read_stdin ->
  IoDefault.log (summarize (String.split (Bytes.to_string bytes) "\n") [])
