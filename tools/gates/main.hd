def last_passed lines =>
  Option.ok_or
    (List.fold lines None fn(selected, line =>
      if String.starts_with line "PASSED: " => Some(line) | selected))
    { message = "InvalidLine" }

def read_report directory name =>
  let path = String.concat directory (String.concat "/" name) ->
  let line = last_passed (String.split (Bytes.to_string (read_file path)) "\n") ->
  report::Report.parse_line (String.concat name (String.concat " " line))

def summarize directory =>
  List.fold (read_dir directory) report::Report.empty fn(tally, name =>
    report::Report.merge tally (read_report directory name))

def main =
  if args
  | [directory, ..._] => report::Report.render (summarize directory)
  | [] => raise { message = "MissingDirectory" }
