type Gate = { name: String; passed: Int; total: Int }

def choose (tally: report::Report.T): report::Report.T =>
  if tally.passed >= 0 => tally
  | report::Report.empty

def main =
  let gates = [
    { name = "m0"; passed = 7; total = 7 },
    { name = "m7"; passed = 1; total = 3 },
    { name = "r31"; passed = 25; total = 25 }
  ] ->
  report::Report.render
    (choose
      (List.fold gates report::Report.empty fn(tally, gate => report::Report.add tally gate.name gate.passed gate.total)))
