def last_passed lines =>
  lines
  |> List.fold None fn(selected, line =>
    if String.starts_with line "PASSED: " => Some(line) | selected)
  |> Option.ok_or { message = "InvalidLine" }

def read_report directory name =>
  let path = String.concat directory (String.concat "/" name) ->
  let line = path |> read_file |> Bytes.to_string |> String.split "\n" |> last_passed ->
  name |> String.concat (String.concat " " line) |> report::Report.parse_line

def summarize directory =>
  directory
  |> read_dir
  |> List.fold report::Report.empty fn(tally, name =>
    report::Report.merge tally (read_report directory name))

def choose (tally: report::Report.T): report::Report.T =>
  if tally.passed >= 0 => tally
  | report::Report.empty

def main =
  if args
  | [directory, ..._] => directory |> summarize |> choose |> report::Report.render
  | [] => raise { message = "MissingDirectory" }
