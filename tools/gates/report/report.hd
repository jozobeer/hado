library

type Tally = { passed: Int; total: Int; red: String List }

def rec join
  | [] => "none"
  | [head] => head
  | [head, ...tail] => String.concat head (String.concat " " (join tail))

def count_fields name counts =>
  if String.split counts "/"
  | [passed, total] => [name, passed, total]
  | raise { message = "InvalidLine" }

module Report
type T
def empty: T Pure
def add(tally: T, name: String, passed: Int, total: Int): T Pure
def merge(left: T, right: T): T Pure
def render(tally: T): String Pure
def fields(line: String): String List {Error}
def parse_line(line: String): T {Error}

implement Report as Report
shared type T = Tally
def empty = { passed = 0; total = 0; red = [] }
def add tally name passed total =>
  if passed < total
  => { passed = tally.passed + passed; total = tally.total + total; red = List.append tally.red [name] }
  | { passed = tally.passed + passed; total = tally.total + total; red = tally.red }
def merge left right =>
  { passed = left.passed + right.passed; total = left.total + right.total; red = List.append left.red right.red }
def render tally =>
  String.concat
    (Int.to_string tally.passed)
    (String.concat
      "/"
      (String.concat
        (Int.to_string tally.total)
        (String.concat " passed; red: " (join tally.red))))
def fields line =>
  if String.split line " PASSED: "
  | [name, counts] => count_fields name counts
  | raise { message = "InvalidLine" }
def parse_line line =>
  if fields line
  | [name, passed, total] => add empty name (Int.parse passed) (Int.parse total)
  | raise { message = "InvalidLine" }
