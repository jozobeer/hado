library

type Tally = { passed: Int; total: Int; red: String List }

def rec join
  | [] => "none"
  | [head] => head
  | [head, ...tail] => head |> String.concat (" " |> String.concat (tail |> join))

def count_fields name counts =>
  if counts |> String.split "/"
  | [passed, total] => [name, passed, total]
  | { message = "InvalidLine" } |> raise

module Report
type T
def empty: T Pure
def add(tally: T, name: String, passed: Int, total: Int): T Pure
def merge(left: T, right: T): T Pure
def render(tally: T): String Pure
def fields(line: String): String List {Error}
def parse_line(line: String): T {Error}

implement Report as Report
shared type T = Tally
def empty = { passed = 0; total = 0; red = [] }
def add tally name passed total =>
  if passed < total
  => { passed = tally.passed + passed; total = tally.total + total; red = tally.red |> List.append [name] }
  | { passed = tally.passed + passed; total = tally.total + total; red = tally.red }
def merge left right =>
  { passed = left.passed + right.passed; total = left.total + right.total; red = left.red |> List.append right.red }
def render tally =>
  tally.passed
  |> Int.to_string
  |> String.concat
    ("/"
      |> String.concat
        (tally.total
          |> Int.to_string
          |> String.concat (" passed; red: " |> String.concat (tally.red |> join))))
def fields line =>
  if line |> String.split " PASSED: "
  | [name, counts] => name |> count_fields counts
  | { message = "InvalidLine" } |> raise
def parse_line line =>
  if line |> fields
  | [name, passed, total] => empty |> add name (passed |> Int.parse) (total |> Int.parse)
  | { message = "InvalidLine" } |> raise
