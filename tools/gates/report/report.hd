library

type Tally = { passed: Int; total: Int; red: String List }

def rec join
  | [] => "none"
  | [head] => head
  | [head, ...tail] => String.concat head (String.concat " " (join tail))

module Report
def empty: Tally Pure
def add(tally: Tally, name: String, passed: Int, total: Int): Tally Pure
def render(tally: Tally): String Pure

implement Report as Report
def empty = { passed = 0; total = 0; red = [] }
def add tally name passed total =>
  if passed < total
  => { passed = tally.passed + passed; total = tally.total + total; red = List.append tally.red [name] }
  | { passed = tally.passed + passed; total = tally.total + total; red = tally.red }
def render tally =>
  String.concat
    (Int.to_string tally.passed)
    (String.concat
      "/"
      (String.concat
        (Int.to_string tally.total)
        (String.concat " passed; red: " (join tally.red))))
