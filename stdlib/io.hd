effect Io
once read_file(path: String): Bytes {Error}
once write_file(path: String, contents: Bytes): Unit {Error}
once log(contents: String): Unit {Error}
once read_dir(path: String): String List {Error}
once read_stdin: Bytes {Error}
module IoDefault
def read_file(path: String): Bytes {Error}
def write_file(path: String, contents: Bytes): Unit {Error}
def log(contents: String): Unit {Error}
def read_dir(path: String): String List {Error}
def read_stdin: Bytes {Error}
implement IoDefault as IoDefault
def io_failure_message
  | 1 => "NotFound"
  | 2 => "PermissionDenied"
  | 3 => "NotADirectory"
  | "IoFailure"
def read_file path =>
  let status = path |> __io_read_file ->
  if status == 0 => 0 |> __io_take_bytes | { message = status |> io_failure_message } |> raise
def write_file path contents =>
  let status = path |> __io_write_file contents ->
  if status == 0 => () | { message = status |> io_failure_message } |> raise
def log contents =>
  let status = contents |> __io_log ->
  if status == 0 => () | { message = status |> io_failure_message } |> raise
def read_dir path =>
  let status = path |> __io_read_dir ->
  if status == 0 => 0 |> directory_elements (0 |> __io_dir_count) | { message = status |> io_failure_message } |> raise
def rec directory_elements (index: Int, count: Int): String List {Error} =>
  if index >= count => [] | [index |> __io_dir_get |> Bytes.to_string, ...(index + 1) |> directory_elements count]
def read_stdin =
  let status = 0 |> __io_read_stdin ->
  if status == 0 => 0 |> __io_take_bytes | { message = status |> io_failure_message } |> raise
