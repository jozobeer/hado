effect Io
once read_file(path: String): Bytes {Error}
once write_file(path: String, contents: Bytes): Unit {Error}
once log(contents: String): Unit {Error}
once read_dir(path: String): String List {Error}
once read_stdin: Bytes {Error}
module IoDefault
def read_file(path: String): Bytes {Error}
def write_file(path: String, contents: Bytes): Unit {Error}
def log(contents: String): Unit {Error}
def read_dir(path: String): String List {Error}
def read_stdin: Bytes {Error}
implement IoDefault as IoDefault
def io_failure_message
  | 1 => "NotFound"
  | 2 => "PermissionDenied"
  | 3 => "NotADirectory"
  | "IoFailure"
def read_file path =>
  let status = __io_read_file path ->
  if status == 0 => __io_take_bytes 0 | raise { message = io_failure_message status }
def write_file path contents =>
  let status = __io_write_file path contents ->
  if status == 0 => () | raise { message = io_failure_message status }
def log contents =>
  let status = __io_log contents ->
  if status == 0 => () | raise { message = io_failure_message status }
def read_dir path =>
  let status = __io_read_dir path ->
  if status == 0 => directory_elements 0 (__io_dir_count 0) | raise { message = io_failure_message status }
def rec directory_elements (index: Int, count: Int): String List {Error} =>
  if index >= count => [] | [__io_dir_get index |> Bytes.to_string, ...directory_elements (index + 1) count]
def read_stdin =
  let status = __io_read_stdin 0 ->
  if status == 0 => __io_take_bytes 0 | raise { message = io_failure_message status }
