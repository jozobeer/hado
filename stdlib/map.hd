type (K, V) MapEntry = | MapEntry(K, V)
module Map
type (K, V) T
def (K, V) empty: (K, V) T
def (K, V) insert (map: (K, V) T, key: K, value: V): (K, V) T
def (K, V) find (map: (K, V) T, key: K): V Option
def (K, V) remove (map: (K, V) T, key: K): (K, V) T
def (K, V, A) fold (map: (K, V) T, initial: A, f: Fn(A, K, V => A)): A
def (K, V) to_list (map: (K, V) T): (K, V) MapEntry List
/module
implement Map as Map
// 実体は左傾赤黒木（LLRB）。色と節と削除の途中結果はこの実装の中だけに置く。
type MapColor = | MapRed | MapBlack
type (K, V) T = | MapLeaf | MapNode(MapColor, (K, V) T, K, V, (K, V) T)
// 削除の再帰の戻り値。鍵が無いときは MapUnchanged を返し、途中で押し下げた赤を捨てて
// 元の木をそのまま返す（no-op）。これが無いと、存在しない鍵の削除で赤黒木の
// 不変条件が壊れ、次の削除が別の鍵を落とす。
type (K, V) MapStep = | MapUnchanged | MapDeleted((K, V) T)
def empty = MapLeaf
// --- 木の観察 ---
def red | MapLeaf => false | MapNode(color, _, _, _, _) => color == MapRed
def left | MapLeaf => MapLeaf | MapNode(_, l, _, _, _) => l
def right | MapLeaf => MapLeaf | MapNode(_, _, _, _, r) => r
def empty_at | MapLeaf => true | MapNode(_, _, _, _, _) => false
// --- 色の操作 ---
def flip | MapRed => MapBlack | MapBlack => MapRed
def repaint | MapLeaf => MapLeaf | MapNode(c, l, k, v, r) => MapNode(flip c, l, k, v, r)
def paint t color => if t | MapLeaf => MapLeaf | MapNode(_, l, k, v, r) => MapNode(color, l, k, v, r)
def flip_colors | MapLeaf => MapLeaf | MapNode(c, l, k, v, r) => MapNode(flip c, repaint l, k, v, repaint r)
// --- 回転 ---
def rotate_left | MapLeaf => MapLeaf | MapNode(c, l, k, v, r) => rotate_left_at c l k v r
def rotate_left_at c l k v r => if r | MapLeaf => MapNode(c, l, k, v, r) | MapNode(_, rl, rk, rv, rr) => MapNode(c, MapNode(MapRed, l, k, v, rl), rk, rv, rr)
def rotate_right | MapLeaf => MapLeaf | MapNode(c, l, k, v, r) => rotate_right_at c l k v r
def rotate_right_at c l k v r => if l | MapLeaf => MapNode(c, l, k, v, r) | MapNode(_, ll, lk, lv, lr) => MapNode(c, ll, lk, lv, MapNode(MapRed, lr, k, v, r))
// --- 赤の不変条件を戻す（Sedgewick の fixUp）---
def fix_right t | red (right t) && not red (left t) => rotate_left t | t
def fix_left t | red (left t) && red (left (left t)) => rotate_right t | t
def fix_flip t | red (left t) && red (right t) => flip_colors t | t
def fix_up t => fix_flip (fix_left (fix_right t))
// --- 挿入 ---
def insert t k v => paint (ins t k v) (MapBlack)
def rec ins t k v => if t | MapLeaf => MapNode(MapRed, MapLeaf, k, v, MapLeaf) | MapNode(c, l, y, vy, r) => ins_at c l y vy r (compare k y) k v
// order == 0 は `compare` が等価と見た鍵。先に入っている鍵 `y` を保ち、値だけを `v` に
// 差し替える（§55）。Float の `-0.0` の後に `+0.0` を入れても鍵は `-0.0` のまま残る。
def rec ins_at c l y vy r order k v | order < 0 => fix_up MapNode(c, ins l k v, y, vy, r) | order > 0 => fix_up MapNode(c, l, y, vy, ins r k v) | fix_up MapNode(c, l, y, v, r)
// --- 探索 ---
def rec find t k => if t | MapLeaf => None | MapNode(_, l, y, vy, r) => find_at (compare k y) l vy r k
def rec find_at order l vy r k | order < 0 => find l k | order > 0 => find r k | Some(vy)
// --- 昇順の畳み込みと列挙 ---
// 木を帰りがけ順（左 → 節 → 右）に辿り、キーの昇順で累算器を呼ぶ。
def rec fold t initial f => if t | MapLeaf => initial | MapNode(_, l, k, v, r) => fold r (f (fold l initial f) k v) f
def to_list t => List.reverse (fold t [] fn(acc, k, v => [MapEntry(k, v), ...acc]))
// --- 削除（LLRB）---
def remove t k => paint (del t k) (MapBlack)
def del t k => if del_step t k | MapUnchanged => t | MapDeleted(next) => next
def rec del_step t k => if t | MapLeaf => MapUnchanged | MapNode(c, l, y, vy, r) => del_step_at MapNode(c, l, y, vy, r) (compare k y) k
def rec del_step_at node order k | order < 0 => del_step_left node k | order == 0 => del_step_eq node k | del_step_gt node k
// order > 0。Sedgewick の delete は等号・大の枝の頭で「左が赤なら右回転」を必ず行う。
// 回転後は必ず右へ降りる（新しい根の鍵は元の鍵より小さいので比較は不要）。
def rec del_step_gt t k => del_step_right (rot_left_if_red t) k
def rot_left_if_red t | red (left t) => rotate_right t | t
def rec del_step_left t k => del_step_left_at (keep_red_left t) k
def rec del_step_left_at t k => del_step_left_rec (del_step (left t) k) t
def rec del_step_left_rec res t => if res | MapUnchanged => MapUnchanged | MapDeleted(next) => del_step_left_build t next
def rec del_step_left_build t next => if t | MapLeaf => MapUnchanged | MapNode(c, _, y, vy, r) => MapDeleted(fix_up MapNode(c, next, y, vy, r))
def keep_red_left t | red (left t) || red (left (left t)) => t | move_red_left t
def rec del_step_right t k => del_step_right_at (keep_red_right t) k
def rec del_step_right_at t k => del_step_right_rec (del_step (right t) k) t
def rec del_step_right_rec res t => if res | MapUnchanged => MapUnchanged | MapDeleted(next) => del_step_right_build t next
def rec del_step_right_build t next => if t | MapLeaf => MapUnchanged | MapNode(c, l, y, vy, _) => MapDeleted(fix_up MapNode(c, l, y, vy, next))
def keep_red_right t | red (right t) || red (left (right t)) => t | move_red_right t
def rec del_step_eq t k => if t | MapLeaf => MapUnchanged | MapNode(c, l, y, vy, r) => del_step_eq_at MapNode(c, l, y, vy, r) k
def rec del_step_eq_at node k | red (left node) => del_step_right (rotate_right node) k | del_step_eq_direct node k
def rec del_step_eq_direct t k => if t | MapLeaf => MapUnchanged | MapNode(c, l, y, vy, r) => del_step_eq_finish MapNode(c, l, y, vy, r) k (empty_at r) (rotates_right MapNode(c, l, y, vy, r))
def rec del_step_eq_finish t k nothing rotates | nothing => MapDeleted(MapLeaf) | rotates => del_step_right t k | del_step_replace (keep_red_right t)
def rotates_right t | red (right t) => false | red (left (right t)) => false | red (left (left t)) => true | false
def del_step_replace | MapLeaf => MapUnchanged | MapNode(c, l, _, _, r) => MapDeleted(fix_up (with_min_from_right c l r))
def move_red_left | MapLeaf => MapLeaf | MapNode(c, l, k, v, r) => move_red_left_at (flip_colors MapNode(c, l, k, v, r))
def move_red_left_at | MapLeaf => MapLeaf | MapNode(c, l, k, v, r) => move_red_left_decide c l k v r
def move_red_left_decide c l k v r | red (left r) => flip_colors (rotate_left MapNode(c, l, k, v, rotate_right r)) | MapNode(c, l, k, v, r)
def move_red_right | MapLeaf => MapLeaf | MapNode(c, l, k, v, r) => move_red_right_at (flip_colors MapNode(c, l, k, v, r))
def move_red_right_at | MapLeaf => MapLeaf | MapNode(c, l, k, v, r) => move_red_right_decide c l k v r
def move_red_right_decide c l k v r | red (left l) => flip_colors (rotate_right MapNode(c, l, k, v, r)) | MapNode(c, l, k, v, r)
// --- 右部分木の最小を根に据えて、その最小を消す ---
def with_min_from_right c l r => with_min_entry c l r (min_entry r)
def with_min_entry c l r entry => if entry | Some(MapEntry(mk, mv)) => MapNode(c, l, mk, mv, delete_min r) | None => MapLeaf
def rec min_entry | MapLeaf => None | MapNode(_, l, k, v, _) => min_choose (min_entry l) MapEntry(k, v)
def min_choose found current => if found | Some(_) => found | None => Some(current)
def rec delete_min | MapLeaf => MapLeaf | MapNode(_, MapLeaf, _, _, _) => MapLeaf | MapNode(c, l, k, v, r) => delete_min_after (keep_red_left MapNode(c, l, k, v, r))
def rec delete_min_after | MapLeaf => MapLeaf | MapNode(c, l, k, v, r) => fix_up MapNode(c, delete_min l, k, v, r)
/implement
