module Array
def A length(xs: A Array): Int Pure
def A get(xs: A Array, index: Int): A {Error}
def A set(xs: A Array, index: Int, value: A): A Array {Error}
def A of_list(xs: A List): A Array Pure
def A to_list(xs: A Array): A List Pure
implement Array as Array
def length xs => xs |> __array_length
def get xs index =>
  if index >= 0 && index < (xs |> length)
    => xs |> __array_get index
    | { message = "IndexOutOfRange" } |> raise
def set xs index value =>
  if index >= 0 && index < (xs |> length)
    => xs |> to_list |> replace index value |> of_list
    | { message = "IndexOutOfRange" } |> raise
def of_list xs => xs |> build 0 (xs |> List.length |> __array_alloc)
def to_list xs => xs |> elements 0 (xs |> length)
// target は構築中だけに閉じ込め、全 slot を埋めた後で公開する。
def rec build xs index target =>
  if xs
  | [] => target
  | [head, ...tail] => tail |> build (index + 1) (target |> __array_fill_unchecked index head)
def rec elements xs index count =>
  if index >= count => [] | [xs |> __array_get index, ...xs |> elements (index + 1) count]
def rec replace xs index value =>
  if xs
  | [] => []
  | [head, ...tail] => head |> replace_head tail index value
def rec replace_head head tail index value =>
  if index == 0 => [value, ...tail] | [head, ...tail |> replace (index - 1) value]
