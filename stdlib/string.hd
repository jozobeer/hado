module String
def length(value: String): Int Pure
def concat(left: String, right: String): String Pure
def slice(s: String, start: Int, end: Int): String {Error}
def get(s: String, index: Int): Char {Error}
def split(s: String, separator: String): String List {Error}
def starts_with(s: String, prefix: String): Bool Pure
def contains(s: String, part: String): Bool Pure
def join(values: String List, separator: String): String Pure
def trim(s: String): String Pure
implement String as String
def length value => value |> __string_length
def concat left right => left |> __string_concat right
def slice s start end =>
  if start >= 0 && start <= end && end <= (s |> length)
    => s |> __string_slice start end
    | { message = "IndexOutOfRange" } |> raise
def get s index =>
  if index >= 0 && index < (s |> length)
    => s |> __string_get index
    | { message = "IndexOutOfRange" } |> raise
def split s separator =>
  if (separator |> length) == 0
    => { message = "EmptySeparator" } |> raise
    | s |> split_from separator 0 (separator |> length) (s |> length)
def rec split_from(s: String, separator: String, start: Int, width: Int, count: Int): String List {Error} =>
  let found = s |> __string_find separator start ->
  if found < 0
    => [s |> slice start count]
    | [s |> slice start found, ...s |> split_from separator (found + width) width count]
def starts_with s prefix =>
  (prefix |> length) <= (s |> length) && (s |> __string_slice 0 (prefix |> length)) == prefix
def contains s part => (part |> length) == 0 || (s |> __string_find part 0) >= 0
def rec join values separator =>
  if values
  | [] => ""
  | [value] => value
  | [head, ...tail] => head |> concat (separator |> concat (tail |> join separator))
def trim s => s |> __string_trim
