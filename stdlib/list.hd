type T List = | Nil | Cons(T, T List)
module List
def (A, B) map(values: A List, f: Fn(A => B)): B List
def A filter(values: A List, predicate: Fn(A => Bool)): A List
def (A, B) fold(values: A List, initial: B, f: Fn(B, A => B)): B
def A length(values: A List): Int Pure
def A reverse(values: A List): A List Pure
def A append(left: A List, right: A List): A List Pure
def A sort(values: A List, comparator: Fn(A, A => Int Pure)): A List Pure
def A head(values: A List): A Option Pure
def A nth(values: A List, index: Int): A Option Pure
def A take(values: A List, count: Int): A List Pure
def A drop(values: A List, count: Int): A List Pure
implement List as List
// acc は逆順に積み、公開する直前に reverse する。自己呼び出しを末尾位置に置く（§53）。
def rec map_go values f acc => if values | [] => reverse acc | [head, ...tail] => map_go tail f [f head, ...acc]
def map values f => map_go values f []
// 述語の結果を引数で受ける。分岐の条件に効果を持つ式は置けない（§36）。
def rec filter_keep head tail predicate acc keep => if keep => filter_go tail predicate [head, ...acc] | filter_go tail predicate acc
def rec filter_go values predicate acc => if values | [] => reverse acc | [head, ...tail] => filter_keep head tail predicate acc (predicate head)
def filter values predicate => filter_go values predicate []
def rec fold values initial f => if values | [] => initial | [head, ...tail] => fold tail (f initial head) f
def rec length_go values count => if values | [] => count | [_, ...tail] => length_go tail (count + 1)
def length values => length_go values 0
def reverse values => fold values [] fn(reversed, value => [value, ...reversed])
def rec prepend_reversed values acc => if values | [] => acc | [head, ...tail] => prepend_reversed tail [head, ...acc]
def append left right => prepend_reversed (reverse left) right
def rec odds_go values acc => if values | [] => reverse acc | [head] => reverse [head, ...acc] | [head, _, ...tail] => odds_go tail [head, ...acc]
def rec evens_go values acc => if values | [] => reverse acc | [_] => reverse acc | [_, next, ...tail] => evens_go tail [next, ...acc]
def odds values => odds_go values []
def evens values => evens_go values []
def rec merge left right comparator acc =>
  if left, right
  | [], _ => append (reverse acc) right
  | _, [] => append (reverse acc) left
  | [a, ...rest_a], [b, ...rest_b] => if
    | comparator a b <= 0 => merge rest_a right comparator [a, ...acc]
    | merge left rest_b comparator [b, ...acc]
def rec merge_sort values comparator =>
  if values
  | [] => []
  | [_] => values
  | [_, _, ..._] => merge (merge_sort (odds values) comparator) (merge_sort (evens values) comparator) comparator []
def sort values comparator => merge_sort values comparator
def head
| [] => None
| [value, ..._] => Some(value)
def nth values index | index < 0 => None | nth_from values index
def rec nth_from values index =>
  if values
  | [] => None
  | [head, ...tail] => nth_more head tail index
def rec nth_more head tail remaining | remaining <= 0 => Some(head) | nth_from tail (remaining - 1)
def rec take_go values count acc => if count <= 0 => reverse acc | take_more values count acc
def rec take_more values count acc => if values | [] => reverse acc | [head, ...tail] => take_go tail (count - 1) [head, ...acc]
def take values count => take_go values count []
def drop values count | count <= 0 => values | drop_from values count
def rec drop_from values count =>
  if values
  | [] => []
  | [_, ...tail] => drop_more tail (count - 1)
def rec drop_more tail remaining | remaining <= 0 => tail | drop_from tail remaining
