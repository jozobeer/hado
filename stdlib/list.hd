type T List = | Nil | Cons(T, T List)
module List
def (A, B) map(values: A List, f: Fn(A => B)): B List
def A filter(values: A List, predicate: Fn(A => Bool)): A List
def (A, B) fold(values: A List, initial: B, f: Fn(B, A => B)): B
def A length(values: A List): Int Pure
def A reverse(values: A List): A List Pure
def A append(left: A List, right: A List): A List Pure
def A sort(values: A List, comparator: Fn(A, A => Int)): A List
def A head(values: A List): A Option Pure
def A nth(values: A List, index: Int): A Option Pure
def A take(values: A List, count: Int): A List Pure
def A drop(values: A List, count: Int): A List Pure
implement List as List
def rec map values f => if values | [] => [] | [head, ...tail] => [head |> f, ...tail |> map f]
def retain head tail keep => if keep => [head, ...tail] | tail
def rec filter values predicate => if values | [] => [] | [head, ...tail] => head |> retain (tail |> filter predicate) (head |> predicate)
def rec fold values initial f => if values | [] => initial | [head, ...tail] => tail |> fold (initial |> f head) f
def rec length | [] => 0 | [_, ...tail] => 1 + (tail |> length)
def reverse values => values |> fold [] fn(reversed, value => [value, ...reversed])
def rec append left right => if left | [] => right | [head, ...tail] => [head, ...tail |> append right]
def rec odds values => if values | [] => [] | [_] => values | [head, _, ...tail] => [head, ...tail |> odds]
def rec evens | [] => [] | [_] => [] | [_, next, ...tail] => [next, ...tail |> evens]
def rec merge left right comparator =>
  if left, right
  | [], _ => right
  | _, [] => left
  | [a, ...rest_a], [b, ...rest_b] => if
    | (a |> comparator b) <= 0 => [a, ...rest_a |> merge right comparator]
    | [b, ...left |> merge rest_b comparator]
def rec sort values comparator => if values | [] => [] | [_] => values | [_, _, ..._] => values |> odds |> sort comparator |> merge (values |> evens |> sort comparator) comparator
def head
| [] => None
| [value, ..._] => Some(value)
def nth values index | index < 0 => None | values |> nth_from index
def rec nth_from values index =>
  if values
  | [] => None
  | [head, ...tail] => head |> nth_more tail index
def rec nth_more head tail remaining | remaining <= 0 => Some(head) | tail |> nth_from (remaining - 1)
def take values count | count <= 0 => [] | values |> take_from count
def rec take_from values count =>
  if values
  | [] => []
  | [head, ...tail] => head |> take_more tail (count - 1)
def rec take_more head tail remaining | remaining <= 0 => [head] | [head, ...tail |> take_from remaining]
def drop values count | count <= 0 => values | values |> drop_from count
def rec drop_from values count =>
  if values
  | [] => []
  | [_, ...tail] => tail |> drop_more (count - 1)
def rec drop_more tail remaining | remaining <= 0 => tail | tail |> drop_from remaining
