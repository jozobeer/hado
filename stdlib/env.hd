effect Env
once args: String List {Error}
once env(name: String): String Option {Error}
once cwd: String {Error}
module EnvDefault
def args: String List {Error}
def env (name: String): String Option {Error}
def cwd: String {Error}
/module
implement EnvDefault as EnvDefault
def args = argv_elements (__argv_count 0 - 1) []
// 添字を末尾から先頭へ動かし、その順に cons する。reverse は要らない。
// `|>` にしない: 効果を持つ呼び出しを `|>` で書くと、末尾呼び出しの引数の
// リストで単相化が `list element type mismatch` になる（docs/issues/pipe-in-tail-argument.md）。
def rec argv_elements (index: Int, acc: String List): String List {Error} => if index < 0 => acc | argv_elements (index - 1) [Bytes.to_string (__argv_get index), ...acc]
def env name => if __env_has name => Some(__env_get name |> Bytes.to_string) | None
def cwd = __cwd 0 as bytes ->
  if Bytes.length bytes == 0 => raise { message = "IoFailure" } | Bytes.to_string bytes
/implement
