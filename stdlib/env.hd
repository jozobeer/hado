effect Env
reply args: String List {Error}
reply env(name: String): String Option {Error}
reply cwd: String {Error}
def default_args = argv_elements 0 (__argv_count 0)
def rec argv_elements (index: Int, count: Int): String List {Error} =>
  if index >= count => [] | [Bytes.to_string (__argv_get index), ...argv_elements (index + 1) count]
def default_env name => if __env_has name => Some(Bytes.to_string (__env_get name)) | None
def default_cwd =
  let bytes = __cwd 0 ->
  if Bytes.length bytes == 0 => raise { message = "IoFailure" } | Bytes.to_string bytes
