effect Env
once args: String List {Error}
once env(name: String): String Option {Error}
once cwd: String {Error}
module EnvDefault
def args: String List {Error}
def env(name: String): String Option {Error}
def cwd: String {Error}
implement EnvDefault as EnvDefault
def args = argv_elements 0 (__argv_count 0)
def rec argv_elements (index: Int, count: Int): String List {Error} =>
  if index >= count => [] | [index |> __argv_get |> Bytes.to_string, ...argv_elements (index + 1) count]
def env name => if __env_has name => Some(name |> __env_get |> Bytes.to_string) | None
def cwd =
  let bytes = __cwd 0 ->
  if Bytes.length bytes == 0 => raise { message = "IoFailure" } | Bytes.to_string bytes
