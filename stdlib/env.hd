effect Env
once args: String List {Error}
once env(name: String): String Option {Error}
once cwd: String {Error}
module EnvDefault
def args: String List {Error}
def env(name: String): String Option {Error}
def cwd: String {Error}
implement EnvDefault as EnvDefault
def args = 0 |> argv_elements (0 |> __argv_count)
def rec argv_elements (index: Int, count: Int): String List {Error} =>
  if index >= count => [] | [index |> __argv_get |> Bytes.to_string, ...(index + 1) |> argv_elements count]
def env name => if name |> __env_has => Some(name |> __env_get |> Bytes.to_string) | None
def cwd =
  let bytes = 0 |> __cwd ->
  if (bytes |> Bytes.length) == 0 => { message = "IoFailure" } |> raise | bytes |> Bytes.to_string
